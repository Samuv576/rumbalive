<mxfile host="app.diagrams.net"><diagram name="Nivel 1 - Contexto" id="page1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1239" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b style=&quot;font-size:28px&quot;&gt;Diagrama de Contexto (C4 Nivel 1) — RumbaLive&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="40" as="geometry" /></mxCell><mxCell id="subtitle" value="&lt;span style=&quot;font-size:16px&quot;&gt;MVP para la Sexta Feria PPI · Sistema de reportes en tiempo real de vida nocturna&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1600" height="30" as="geometry" /></mxCell><mxCell id="usuario" value="&lt;b style=&quot;font-size:20px&quot;&gt;👤 Usuario (Rumbero)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Persona]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Sale de rumba en Medellín. Consulta y reporta&lt;br&gt;el estado de fila, cover y aforo de un local.&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="396" y="106" width="408" height="115" as="geometry" /></mxCell><mxCell id="rumbalive" value="&lt;b style=&quot;font-size:20px&quot;&gt;RumbaLive&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Sistema de software]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Permite consultar y reportar en tiempo real el&lt;br&gt;estado de locales de vida nocturna mediante&lt;br&gt;crowdsourcing validado por geofencing (Give to Get).&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="366" y="344" width="468" height="130" as="geometry" /></mxCell><mxCell id="auth" value="&lt;b style=&quot;font-size:20px&quot;&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Gestiona el registro e inicio&lt;br&gt;de sesión de los usuarios.&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="36" y="582" width="338" height="115" as="geometry" /></mxCell><mxCell id="geo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Geolocalización del navegador&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Provee la posición GPS del dispositivo&lt;br&gt;para validar el geofence.&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="431" y="582" width="338" height="115" as="geometry" /></mxCell><mxCell id="maps" value="&lt;b style=&quot;font-size:20px&quot;&gt;Proveedor de mapa base&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Sistema externo]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Entrega los tiles del mapa sobre el que&lt;br&gt;se dibujan los locales (ej. OpenStreetMap).&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="826" y="582" width="338" height="115" as="geometry" /></mxCell><mxCell id="e0" value="Consulta el mapa y reporta&lt;br&gt;fila / cover / aforo&lt;br&gt;[HTTPS]" edge="1" parent="1" source="usuario" target="rumbalive" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="Autentica usuarios&lt;br&gt;[HTTPS]" edge="1" parent="1" source="rumbalive" target="auth" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="Solicita coordenadas GPS&lt;br&gt;[Browser Geolocation API]" edge="1" parent="1" source="rumbalive" target="geo" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Descarga tiles del mapa&lt;br&gt;[HTTPS]" edge="1" parent="1" source="rumbalive" target="maps" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend_box" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="79" y="736" width="320" height="134" as="geometry" /></mxCell><mxCell id="leg_c0" value="" style="rounded=0;html=1;fillColor=#08427B;strokeColor=#052E56;" vertex="1" parent="1"><mxGeometry x="91" y="776" width="36" height="22" as="geometry" /></mxCell><mxCell id="leg_t0" value="Persona (usuario del sistema)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="137" y="772" width="260" height="30" as="geometry" /></mxCell><mxCell id="leg_c1" value="" style="rounded=0;html=1;f