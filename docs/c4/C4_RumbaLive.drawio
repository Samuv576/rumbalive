ex="1" parent="1"><mxGeometry x="40" y="298" width="707" height="992" as="geometry" /></mxCell><mxCell id="usuario" value="&lt;b style=&quot;font-size:20px&quot;&gt;👤 Usuario (Rumbero)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Persona]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Consulta el mapa y reporta el&lt;br&gt;estado de un local.&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="348" y="106" width="338" height="115" as="geometry" /></mxCell><mxCell id="auth" value="&lt;b style=&quot;font-size:20px&quot;&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Sistema externo]&lt;/i&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="773" y="610" width="308" height="74" as="geometry" /></mxCell><mxCell id="geo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Geolocalización&lt;br&gt;del navegador&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Sistema externo]&lt;/i&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1138" y="601" width="308" height="92" as="geometry" /></mxCell><mxCell id="maps" value="&lt;b style=&quot;font-size:20px&quot;&gt;Proveedor de&lt;br&gt;mapa base&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Sistema externo]&lt;/i&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1503" y="601" width="308" height="92" as="geometry" /></mxCell><mxCell id="webapp" value="&lt;b style=&quot;font-size:20px&quot;&gt;App Web / PWA&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Contenedor: PWA · JavaScript]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Interfaz Zero-Text-Entry: mapa, check-in&lt;br&gt;y reporte táctil. Corre en el navegador&lt;br&gt;del celular del usuario.&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="313" y="352" width="408" height="130" as="geometry" /></mxCell><mxCell id="api" value="&lt;b style=&quot;font-size:20px&quot;&gt;API REST&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Contenedor: Supabase · PostgREST]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;API autogenerada sobre Postgres. Expone&lt;br&gt;check-in, reportes, locales y estado.&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="66" y="590" width="408" height="115" as="geometry" /></mxCell><mxCell id="logic" value="&lt;b style=&quot;font-size:20px&quot;&gt;Lógica de negocio&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Contenedor: PL/pgSQL + políticas RLS]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Valida geofence y dwell-time, aplica el&lt;br&gt;Give-to-Get y agrega el estado de cada local.&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="66" y="924" width="408" height="115" as="geometry" /></mxCell><mxCell id="realtime" value="&lt;b style=&quot;font-size:20px&quot;&gt;Realtime&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Contenedor: Supabase Realtime]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Publica los cambios de reportes a los clientes&lt;br&gt;conectados (respeta las políticas RLS).&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="313" y="757" width="408" height="115" as="geometry" /></mxCell><mxCell id="db" value="&lt;b style=&quot;font-size:20px&quot;&gt;Base de Datos&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Contenedor: PostgreSQL + PostGIS]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Almacena usuarios, locales, check-ins y&lt;br&gt;reportes. Resuelve las consultas geoespaciales.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="1147" width="408" height="117" as="geometry" /></mxCell><mxCell id="e0" value="Usa&lt;br&gt;[HTTPS]" edge="1" parent="1" source="usuario" target="webapp" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="Login / registro&lt;br&gt;[HTTPS]" edge="1" parent="1" source="webapp" target="auth" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="Obtiene lat/long&lt;br&gt;[Browser API]" edge="1" parent="1" source="webapp" target="geo" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Descarga tiles&lt;br&gt;[HTTPS]" edge="1" parent="1" source="webapp" target="maps" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="Check-in, reportes y consultas&lt;br&gt;[JSON/HTTPS]" edge="1" parent="1" source="webapp" target="api" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="Se suscribe a cambios&lt;br&gt;en vivo [WebSocket]" edge="1" parent="1" source="webapp" target="realtime" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="Invoca funciones&lt;br&gt;[SQL / RPC]" edge="1" parent="1" source="api" target="logic" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="Lee / escribe&lt;br&gt;[SQL]" edge="1" parent="1" source="logic" target="db" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="Escucha cambios&lt;br&gt;[Replicación lógica]" edge="1" parent="1" source="realtime" target="db" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend_box" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="777" y="744" width="320" 