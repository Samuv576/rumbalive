"&lt;b style=&quot;font-size:28px&quot;&gt;Diagrama de Componentes (C4 Nivel 3) — Lógica de negocio&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="40" as="geometry" /></mxCell><mxCell id="subtitle" value="&lt;span style=&quot;font-size:16px&quot;&gt;Componentes internos del contenedor «Lógica de negocio» de RumbaLive&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1600" height="30" as="geometry" /></mxCell><mxCell id="cluster0" value="&lt;b&gt;Lógica de negocio&lt;/b&gt; [PL/pgSQL + políticas RLS] — límite del contenedor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#777777;dashed=1;dashPattern=8 8;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=16;" vertex="1" parent="1"><mxGeometry x="133" y="235" width="1436" height="389" as="geometry" /></mxCell><mxCell id="api" value="&lt;b style=&quot;font-size:20px&quot;&gt;API REST&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Contenedor: Supabase · PostgREST]&lt;/i&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="694" y="106" width="328" height="74" as="geometry" /></mxCell><mxCell id="realtime" value="&lt;b style=&quot;font-size:20px&quot;&gt;Realtime&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Contenedor: Supabase Realtime]&lt;/i&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1439" y="106" width="328" height="74" as="geometry" /></mxCell><mxCell id="checkin" value="&lt;b style=&quot;font-size:20px&quot;&gt;Registrador de Check-in&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Componente: función SQL]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Valida el geofence y registra que el&lt;br&gt;usuario declaró estar en el local.&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="511" y="289" width="328" height="115" as="geometry" /></mxCell><mxCell id="report" value="&lt;b style=&quot;font-size:20px&quot;&gt;Manejador de Reportes&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Componente: función SQL]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Orquesta las validaciones, inserta el&lt;br&gt;reporte y actualiza ultimo_reporte_en.&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1215" y="289" width="328" height="115" as="geometry" /></mxCell><mxCell id="nearby" value="&lt;b style=&quot;font-size:20px&quot;&gt;Locales Cercanos&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Componente: función SQL]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Lista los locales dentro del radio,&lt;br&gt;ordenados por distancia (sin estado).&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="159" y="289" width="328" height="115" as="geometry" /></mxCell><mxCell id="agg" value="&lt;b style=&quot;font-size:20px&quot;&gt;Agregador de Estado&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Componente: función SQL]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Calcula fila / cover / aforo a partir del&lt;br&gt;reporte válido más reciente.&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="863" y="289" width="328" height="115" as="geometry" /></mxCell><mxCell id="geoval" value="&lt;b style=&quot;font-size:20px&quot;&gt;Validador de Geofence&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Componente: función SQL]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;ST_DWithin entre la ubicación enviada&lt;br&gt;y el centroide del local (radio fijo).&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="511" y="483" width="328" height="115" as="geometry" /></mxCell><mxCell id="dwell" value="&lt;b style=&quot;font-size:20px&quot;&gt;Validador de Dwell-Time&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Componente: función SQL]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Exige que el último check-in válido&lt;br&gt;tenga mín. 3 min y máx. 2 h de antigüedad.&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1215" y="483" width="328" height="115" as="geometry" /></mxCell><mxCell id="gate" value="&lt;b style=&quot;font-size:20px&quot;&gt;Guardián Give-to-Get&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Componente: política RLS]&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Permite leer el estado solo si el usuario&lt;br&gt;tiene un reporte vigente esa noche.&lt;/span&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="863" y="483" width="328" height="115" as="geometry" /></mxCell><mxCell id="db" value="&lt;b style=&quot;font-size:20px&quot;&gt;Base de Datos&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:14px&quot;&gt;[Contenedor: PostgreSQL + PostGIS]&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="36" y="679" width="328" height="76" as="geometry" /></mxCell><mxCell id="e0" value="POST /checkins" edge="1" parent="1" source="api" target="checkin" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="POST /reportes" edge="1" parent="1" source="api" target="report" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="GET /locales/nearby" edge="1" parent="1" source="api" target="nearby" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="GET /locales/{id}/status" edge="1" parent="1" source="api" target="agg" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="invoca" edge="1" parent="1" source="checkin" target="geoval" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#555555;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="invoca" edge="1" parent="1" sour